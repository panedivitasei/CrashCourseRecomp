// Crash Course 1 (crashcourse1 recomp) - Windows resources.
// MAINICON is the name the runtime's window class loads
// (src/ui/window_win.cpp: LoadIconW(hinstance, L"MAINICON")), and the first
// icon resource is also what Explorer/taskbar show for the exe.
// The VERSIONINFO FileDescription is the display name Task Manager uses.

#include "version.h"

MAINICON ICON "icon.ico"

1 VERSIONINFO
FILEVERSION CC1_VERSION_MAJOR,CC1_VERSION_MINOR,CC1_VERSION_PATCH,0
PRODUCTVERSION CC1_VERSION_MAJOR,CC1_VERSION_MINOR,CC1_VERSION_PATCH,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Crash Course 1"
      VALUE "ProductName", "Crash Course 1"
      VALUE "FileVersion", CC1_VERSION_TEXT
      VALUE "ProductVersion", CC1_VERSION_TEXT
      VALUE "InternalName", "crashcourse1"
      VALUE "OriginalFilename", "crashcourse1.exe"
      VALUE "CompanyName", "ReXGlue recompilation"
      VALUE "LegalCopyright", "Game content (c) Wanako / Doritos. Recompiled with ReXGlue."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
